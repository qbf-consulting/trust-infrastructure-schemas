{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/sankarshanmukhopadhyay/trust-infrastructure-schemas/main/conformance/external-conformance-profile-declaration.schema.json",
  "title": "TSMS External Conformance Profile Declaration",
  "description": "Portable declaration of an external implementation's claimed support for a bounded TSMM semantic conformance profile, with explicit implementation identity and evidence references. The contract serializes a claim but does not redefine TSMM semantics or establish certification.",
  "type": "object",
  "required": ["profile_id", "profile_version", "implementation", "requirements"],
  "additionalProperties": false,
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "implementation": {
      "type": "object",
      "required": ["name", "version", "repository"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://github.com/"}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "support", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^TSMM-CONF-[A-Z0-9-]+$"},
          "support": {"type": "string", "enum": ["supported", "unsupported", "unknown"]},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

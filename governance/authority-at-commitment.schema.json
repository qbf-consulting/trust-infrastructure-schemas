{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/sankarshanmukhopadhyay/trust-infrastructure-schemas/v0.9.0/governance/authority-at-commitment.schema.json",
  "title": "Authority at Commitment Contract",
  "description": "Portable contract for recording the authority evidence, exact action binding, approval state and decision at a material commitment boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "exercise_id",
    "principal",
    "actor",
    "mandate",
    "action",
    "evaluation",
    "policy",
    "authority_state",
    "constraints",
    "approval",
    "decision",
    "evidence"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "exercise_id": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "$ref": "#/$defs/ref"
    },
    "actor": {
      "$ref": "#/$defs/ref"
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "counterparty": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at"
      ],
      "properties": {
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "requested_historical_time": {
          "type": "string",
          "format": "date-time"
        },
        "reconstructed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_state": {
      "enum": [
        "active",
        "suspended",
        "revoked",
        "expired",
        "unknown",
        "unavailable"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "satisfied",
              "failed",
              "indeterminate"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "present"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "present": {
          "type": "boolean"
        },
        "approval_ref": {
          "type": "string"
        },
        "action_digest": {
          "$ref": "#/$defs/digest"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason_codes"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "permit",
            "deny",
            "indeterminate"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "kind"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "authority",
              "delegation",
              "status",
              "revocation",
              "approval",
              "policy",
              "decision",
              "other"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "const": "permit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "authority_state": {
            "const": "active"
          },
          "constraints": {
            "not": {
              "contains": {
                "properties": {
                  "result": {
                    "enum": [
                      "failed",
                      "indeterminate"
                    ]
                  }
                },
                "required": [
                  "result"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "required": [
              "approval_ref",
              "action_digest"
            ],
            "properties": {
              "present": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  },
  "x-tsmm-semantic-binding": {
    "semanticAuthority": "trust-systems-meta-model",
    "relationship": "portable-contract",
    "authorityTransfer": false,
    "profile": "authority-at-commitment"
  }
}
